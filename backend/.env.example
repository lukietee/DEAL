PORT=3000
MOCK_MODE=true                      # true = no Anthropic calls; uses content/ + mock extractions
ANTHROPIC_API_KEY=
CUE_MODEL=claude-haiku-5-5
AGREEMENT_MODEL=claude-sonnet-5-5
RESEARCH_MODEL=claude-opus-5-5     # live research agents (web search); runs 3 in parallel per session
SUPABASE_URL=                       # empty = in-memory store
SUPABASE_SERVICE_ROLE_KEY=          # backend only, never in the iOS app
STRIPE_SECRET_KEY=sk_test_...       # test mode only (sk_test_ or rk_test_ with PaymentIntents: Write); empty = fake receipts

# Optional
# HOST=0.0.0.0                      # bind address (0.0.0.0 so an iPhone on LAN/ngrok can reach it)
# DISPLAY_TZ=America/Los_Angeles    # time zone used in mismatch explanations ("at 2:14 PM")
# MERCHANT_NAME=DEAL Demo Seller
# CONTENT_DIR=../content

# Nebius Token Factory (Nemotron) — https://tokenfactory.nebius.com/project/api-keys
NEBIUS_API_KEY=
# Tavily web search — https://app.tavily.com
TAVILY_API_KEY=
